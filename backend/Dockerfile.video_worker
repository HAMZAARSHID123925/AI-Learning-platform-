# =============================================================================
# ELARION Video Generation Worker — Dockerfile
# =============================================================================
# Requires Python for the backend worker, plus Node.js + Remotion + FFmpeg
# =============================================================================

FROM python:3.12-slim

# Set non-interactive to prevent apt prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies:
# - FFmpeg
# - Node.js (via curl)
# - Chromium & its dependencies (for Remotion/Puppeteer)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    ffmpeg \
    chromium \
    libnss3 \
    libatk-bridge2.0-0 \
    libx11-xcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxi6 \
    libxtst6 \
    libnss3 \
    libcups2 \
    libxss1 \
    libxrandr2 \
    libasound2 \
    libpangocairo-1.0-0 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libpq-dev \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Remotion needs to know where Chromium is so it doesn't try to download it
ENV REMOTION_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# We run as root in this specific image because Remotion/Puppeteer inside Docker
# often requires --no-sandbox which we pass in Remotion config. 
# Creating a non-root user that can use Chromium is possible but complex for MVP.
# For P2.0, we will try to use a non-root user for security.
RUN useradd --create-home --shell /bin/bash elarion
USER elarion

WORKDIR /home/elarion/app

# Install Python deps
COPY --chown=elarion:elarion backend/requirements.txt ./backend/
RUN pip install --no-cache-dir --user -r backend/requirements.txt
ENV PATH="/home/elarion/.local/bin:${PATH}"

# Install Node.js deps for video-render
WORKDIR /home/elarion/app/video-render
COPY --chown=elarion:elarion video-render/package.json video-render/package-lock.json ./
RUN npm ci

# Copy full application code
WORKDIR /home/elarion/app
COPY --chown=elarion:elarion backend ./backend
COPY --chown=elarion:elarion video-render ./video-render

# Ensure temp directory exists for rendering
RUN mkdir -p /home/elarion/app/tmp && chown elarion:elarion /home/elarion/app/tmp
ENV TEMP_DIR=/home/elarion/app/tmp

WORKDIR /home/elarion/app/backend
CMD ["python", "-m", "app.workers.video_generation_consumer"]
