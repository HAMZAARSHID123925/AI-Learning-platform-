# =============================================================================
# ELARION Backend — Environment Variables Template
# =============================================================================
# Instructions:
#   1. Copy this file: cp .env.example .env
#   2. Fill in all values marked [REQUIRED]
#   3. NEVER commit .env to git — it is in .gitignore
# =============================================================================

# --- Application Environment -------------------------------------------------
ENVIRONMENT=development          # development | staging | production

# --- Database ----------------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://elarion_user:elarion_pass@localhost:5432/elarion

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- JWT (RSA Key Pair) -------------------------------------------------------
# Generate key pair:
#   mkdir -p keys
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
#
# WHY RS256 (asymmetric) instead of HS256 (symmetric)?
#   HS256: Same key signs and verifies — if leaked, all tokens can be forged.
#   RS256: Private key signs only (stays on backend). Public key verifies.
#          Any microservice can verify tokens WITHOUT the private key.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15       # Short-lived — reduces exposure window
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=RS256

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Object Storage (MinIO for dev / AWS S3 / Cloudflare R2 for prod) --------
S3_ENDPOINT_URL=http://localhost:9000    # Remove this line for real AWS S3
S3_ACCESS_KEY_ID=minio_access_key       # [REQUIRED] — Replace in prod
S3_SECRET_ACCESS_KEY=minio_secret_key  # [REQUIRED] — Replace in prod
S3_BUCKET_NAME=elarion-assets
S3_REGION=us-east-1

# --- AI — Embeddings (Dev: FastEmbed local, Prod: OpenAI) --------------------
# Development: BAAI/bge-small-en-v1.5 via fastembed (local, no API key needed)
# Production:  Switch to OpenAI text-embedding-3-small (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=fastembed              # fastembed | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # Dev model (384 dims)
EMBEDDING_DIM=384                         # MUST match model output dimension

# Production embedding config (leave blank in dev):
OPENAI_API_KEY=                           # [REQUIRED in prod] — For embeddings

# --- AI — LLM (Dev: Groq free, Prod: Anthropic Claude) ----------------------
# Development: Groq (free tier, very fast Llama 3.3 70B)
# Production:  Anthropic Claude API
LLM_PROVIDER=groq                         # groq | anthropic
GROQ_API_KEY=                             # [REQUIRED in dev] — Get free at console.groq.com
ANTHROPIC_API_KEY=                        # [REQUIRED in prod] — claude-opus-4-5

# Groq model for dev (Phase 2+):
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Anthropic model for prod (Phase 2+):
ANTHROPIC_LLM_MODEL=claude-opus-4-5

# --- Live Video Provider (Phase 4) -------------------------------------------
# Development: MockVideoProvider (returns fake tokens — no real video)
# Production:  Choose one: zoom | agora | daily
VIDEO_PROVIDER=mock                       # mock | zoom | agora | daily
# ZOOM_API_KEY=                           # Fill when switching to zoom
# ZOOM_API_SECRET=                        # Fill when switching to zoom
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# DAILY_API_KEY=

# --- Email (Phase 1: console logger, Prod: real SMTP) ------------------------
EMAIL_PROVIDER=console                    # console | smtp | sendgrid | mailgun
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@elarion.edu

# --- Observability (Optional — can leave blank in dev) ----------------------
OTEL_EXPORTER_OTLP_ENDPOINT=             # e.g. http://localhost:4317

# --- Frontend URL (for password reset links) ---------------------------------
FRONTEND_URL=http://localhost:3000
