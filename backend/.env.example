# =============================================================================
# ELARION Backend — Environment Variables Template
# =============================================================================
# Instructions:
#   1. Copy this file: cp .env.example .env
#   2. Fill in all values marked [REQUIRED]
#   3. NEVER commit .env to git — it is in .gitignore
# =============================================================================

# --- PRODUCTION SECURITY -----------------------------------------------------
ENVIRONMENT=development          # development | staging | production
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=RS256

# --- CORE REQUIRED -----------------------------------------------------------
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=
REDIS_URL=

# --- STORAGE REQUIRED --------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=elarion-assets
S3_REGION=us-east-1

# --- AI REQUIRED FOR AI FEATURES ---------------------------------------------
LLM_PROVIDER=openai                         # groq | anthropic | openai
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_LLM_MODEL=claude-opus-4-5
OPENAI_LLM_MODEL=gpt-4o

EMBEDDING_PROVIDER=fastembed              # fastembed | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
OPENAI_API_KEY=

# --- TTS REQUIRED FOR REAL VIDEO ---------------------------------------------
TTS_PROVIDER=openai_tts                   # openai_tts | elevenlabs
TTS_MOCK_MODE=True
# OPENAI_TTS_API_KEY is optional if OPENAI_API_KEY is used as the shared OpenAI credential.
OPENAI_TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# --- Live Video Provider (Phase 4) -------------------------------------------
VIDEO_PROVIDER=mock                       # mock | zoom | agora | daily
ZOOM_API_KEY=
ZOOM_API_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
DAILY_API_KEY=

# --- Email (Phase 1: console logger, Prod: real SMTP) ------------------------
EMAIL_PROVIDER=console                    # console | smtp | sendgrid | mailgun
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@elarion.edu

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
